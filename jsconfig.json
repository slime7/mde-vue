{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "mdu-ui": ["./src/index.js"],
      "mdu-ui/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.vue",
    "docs/**/*.js",
    "docs/**/*.vue",
    "scripts/**/*.mjs",
    "tests/**/*.js",
    "*.config.js",
    "*.config.mjs"
  ]
}
